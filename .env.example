# OpenCloud OMV deployment — environment variables
# Fill in your values before starting the stack.
#
# Required: OC_DOMAIN, INITIAL_ADMIN_PASSWORD, COLLABORA_DOMAIN, WOPISERVER_DOMAIN

##############################################################################
# Domains
##############################################################################

# Main OpenCloud URL
OC_DOMAIN=opencloud.example.com

# Collabora Office
COLLABORA_DOMAIN=collabora.example.com

# WOPI server (collaboration service)
WOPISERVER_DOMAIN=wopi.example.com

##############################################################################
# Passwords
##############################################################################

# OpenCloud admin password
INITIAL_ADMIN_PASSWORD=changeme

# Collabora admin UI credentials (for /cool/adminws)
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=changeme

##############################################################################
# Persistent storage
# Default: named Docker volumes (managed by Docker)
# Recommended: set to absolute host paths on OMV for easy access and backup
# Example: OC_CONFIG_DIR=/srv/dev-disk-by-uuid-XXXX/opencloud/config
##############################################################################

OC_CONFIG_DIR=/path/to/opencloud/config
OC_DATA_DIR=/path/to/opencloud/data
RADICALE_CONFIG_DIR=/path/to/opencloud-radicale/config/config
RADICALE_DATA_DIR=/path/to/appdata/opencloud-radicale/data

##############################################################################
# Container user (UID:GID)
# Set to match the user that owns the storage directories above.
# Find your UID/GID with: id $(whoami)
##############################################################################

OC_CONTAINER_UID_GID=1000:1001

##############################################################################
# Docker images
##############################################################################

OC_DOCKER_IMAGE=opencloudeu/opencloud-rolling
OC_DOCKER_TAG=latest

##############################################################################
# Security
# Only set INSECURE=true if your SWAG certificate is self-signed.
# With a valid Let's Encrypt cert (the normal SWAG setup) leave this false.
##############################################################################

INSECURE=false

##############################################################################
# Optional: email / SMTP notifications
##############################################################################

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SENDER=OpenCloud Notifications <notifications@example.com>
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=changeme
SMTP_INSECURE=false
SMTP_AUTHENTICATION=plain
SMTP_TRANSPORT_ENCRYPTION=starttls

##############################################################################
# Optional: misc
##############################################################################

# Default UI language (ISO 639-1 code, e.g. de, fr). Leave empty for English.
DEFAULT_LANGUAGE=en

# Log level: debug | info | warn | error
LOG_LEVEL=warn

# Enable demo users (admin, einstein, marie, …) — do not use in production
DEMO_USERS=false

# Log driver (local, json-file, journald, …)
LOG_DRIVER=json-file

# Collabora: force home mode (single-user, no admin panel)
#COLLABORA_HOME_MODE=false
